# انسخ إلى .env وعدّل القيم
NODE_ENV=development
PORT=4000
WEB_BASE=http://localhost:5173
API_BASE=http://localhost:4000

# أسرار — ولّدها بـ: openssl rand -hex 32
JWT_SECRET=change_me_64_hex_chars
MASTER_KEY=change_me_64_hex_chars

DB_PATH=./data/loansocial.db
UPLOAD_DIR=./data/uploads

# Meta (Facebook / Instagram)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=loansocial_verify
META_GRAPH=https://graph.facebook.com/v20.0

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API
WA_PHONE_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=loansocial_wa_verify

# تشغيل المحاكاة عند غياب التوكنات (1 = محاكاة)
SIMULATE_PUBLISH=1
